FROM python:3.11-slim-bookworm

WORKDIR /MoneyPrinterTurbo

ENV PYTHONPATH=/MoneyPrinterTurbo \
    PYTHONUNBUFFERED=1 \
    IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg \
    MPT_WEBUI_HOST=0.0.0.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ffmpeg git fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir --retries 3 --timeout 120 -r requirements.txt

COPY . .
RUN chmod +x /MoneyPrinterTurbo/docker/coolify-entrypoint.sh \
    && mkdir -p /data/storage

VOLUME ["/data"]
EXPOSE 8080 8501

ENTRYPOINT ["/MoneyPrinterTurbo/docker/coolify-entrypoint.sh"]
CMD ["python3", "main.py"]
